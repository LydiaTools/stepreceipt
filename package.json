{
  "name": "stepreceipt",
  "version": "0.5.0",
  "type": "module",
  "description": "Record browser-agent actions beside explicit outcome checks; export portable HTML reports and CI summaries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LydiaTools/stepreceipt.git"
  },
  "homepage": "https://lydiatools.github.io/stepreceipt/",
  "bugs": {
    "url": "https://github.com/LydiaTools/stepreceipt/issues"
  },
  "keywords": [
    "browser-agent",
    "agent-reliability",
    "playwright",
    "verification",
    "ci",
    "html-report"
  ],
  "bin": {
    "stepreceipt": "./bin/stepreceipt.mjs"
  },
  "files": [
    "bin/stepreceipt.mjs",
    "src/",
    "examples/*.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/PLAYWRIGHT*.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/receipt.mjs",
    "./report": "./src/report.mjs",
    "./summary": "./src/summary.mjs",
    "./playwright": "./src/playwright.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node examples/demo.mjs",
    "test:e2e": "node test/e2e.mjs",
    "demo:blueprint": "node examples/blueprint/run.mjs",
    "test:blueprint": "node test/blueprint-e2e.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "browser-agent-blueprint": "https://codeload.github.com/LydiaTools/browser-agent-blueprint/tar.gz/630d773c44cc41f35128d14344a77339906b9504",
    "playwright": "1.64.1"
  }
}
